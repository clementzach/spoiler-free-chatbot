# Copy to .env (never commit it) and fill in.
OPENAI_API_KEY=
# Which judge screens replies: llm | decisions | jev
JUDGE=llm
# Required only when JUDGE=jev (key from console.typesafe.ai)
TYPESAFE_API_KEY=

# Optional overrides
# MAIN_MODEL=gpt-6-luna
# JUDGE_MODEL=gpt-4.1-mini
# DECISIONS_THRESHOLD=0.5
# JEV_THRESHOLD=0.5
# PORT=8000
