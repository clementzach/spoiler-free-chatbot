# Copy to .env (never commit it) and fill in.
OPENAI_API_KEY=
# Which judge screens replies: llm | decisions | jev
JUDGE=llm
# Required only when JUDGE=jev (key from console.typesafe.ai)
TYPESAFE_API_KEY=

# Optional overrides
# MAIN_MODEL=gpt-6-luna
# JUDGE_MODEL=gpt-4.1-mini
# DECISIONS_THRESHOLD=0.5
# JEV_THRESHOLD=0.5
# PORT=8000
# LOG_LEVEL=INFO          # DEBUG | INFO | WARNING | ERROR
# LOG_CONTENT=0           # 1 = also log short snippets of chat text (off by default)
# JUDGE_CONTEXT_TOKENS=100000   # the judge sees the whole chat up to about this many tokens
# API_TIMEOUT=60          # seconds per OpenAI / TypeSafe request attempt
# API_MAX_RETRIES=3       # retries after a timeout, connection error, 429 or 5xx
# CHAT_TIMEOUT=180        # seconds for a whole chat turn (generate, judge, regenerate)
